{
  "namespace": "chest",
  "small_chest_screen": {
    "$shop_panel_title|default": "$container_title",
    "modifications": [
      {
        "array_name": "variables",
        "operation": "insert_back",
        "value": [
          {
            "requires": "(not (($shop_panel_title - '§s§h§o§p§r') = $shop_panel_title))",
            "$screen_content": "data_driven_container.desktop_panel",
            "$screen_bg_content": "common.screen_background",
            "$screen_background_alpha": 0.4
          }
        ]
      }
    ]
  },
  "large_chest_screen": {
    "$shop_panel_title|default": "$container_title",
    "modifications": [
      {
        "array_name": "variables",
        "operation": "insert_back",
        "value": [
          {
            "requires": "(not (($shop_panel_title - '§s§h§o§p§r') = $shop_panel_title))",
            "$screen_content": "data_driven_container.desktop_panel",
            "$screen_bg_content": "common.screen_background",
            "$screen_background_alpha": 0.4
          }
        ]
      }
    ]
  }
}